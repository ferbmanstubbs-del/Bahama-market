.WXcCMq_navigationMenuTrigger[data-state="active"] { background-color: var(--expo-router-tabs-active-background-color, #444); }

.WXcCMq_tabText { font-weight: var(--expo-router-tabs-font-weight, 500); font-size: var(--expo-router-tabs-font-size, 15px); font-family: var(--expo-router-tabs-font-family); font-style: var(--expo-router-tabs-font-style, normal); opacity: var(--expo-router-tabs-text-opacity, 1); color: var(--expo-router-tabs-text-color, #8b8b8b); white-space: nowrap; }

