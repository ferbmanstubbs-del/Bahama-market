:root { --expo-router-tabs-font-family: --apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }

.WXcCMq_nativeTabsContainer { flex-direction: column; flex: 1 1 0%; max-width: 100vw; max-height: 100vh; display: flex; overflow: hidden; }

.WXcCMq_tabContent { flex: 1 1 0%; max-width: 100%; max-height: 100%; display: flex; }

.WXcCMq_tabContent[data-state="inactive"] { display: none; }

